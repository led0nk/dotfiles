// config for DP-1

[
  {
    "layer": "top",
    "position": "top",
    "modules-left": [
      "sway/workspaces",
      "sway/scratchpad",
    ],
    "modules-center": [
      "clock",
    ],
    "modules-right": [
      "tray",
      "mpris",
      "backlight",
      "pulseaudio",
      "network",
      "custom/battery",
      "cpu",
      "memory",
      "custom/notification",
      "custom/logout",
    ],
    // Modules configuration
    "sway/workspaces": {
         "disable-scroll": true,
         "all-outputs": true,
         "persist": true,
         "warp-on-scroll": false,
         "format": "{name}",
         "format-icons": {
             "1": "",
             "2": "",
             "3": "",
             "4": "",
             "5": "",
             "7": "",
             "8": "",
             "urgent": "",
             "focused": "",
             "default": ""
         }
     },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    "custom/weather": {
      "exec": "curl -s wttr.in/Hürtgenwald?format=1",
      "interval": 100,
      "format": " {}",
      "tooltip": false,
    },
    "custom/media": {
        "format": "{icon} {text}",
        "escape": true,
        "return-type": "json",
        "max-length": 40,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl stop",
        "smooth-scrolling-threshold": 5,
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "exec": "$HOME/.config/waybar/scripts/mediaplayer.py 2> /dev/null &",
    },

    "custom/spotify": {
        "format": "{icon} {name}",
        "escape": true,
        "return-type": "json",
        "max-length": 40,
        "interval": 30, 
        "on-click": "playerctl -p spotify play-pause",
        "on-click-right": "killall spotify",
        "smooth-scrolling-threshold": 10, 
        "on-scroll-up" : "playerctl -p spotify next",
        "on-scroll-down" : "playerctl -p spotify previous",
        "exec": "~/.config/waybar/scripts/mediaplayer.py 2> /dev/null",       
        "exec-if": "pgrep spotify"
    },

    "custom/dunst": {
      "tooltip": false,
      /*"format": "{icon}",
      "format-icons": {
        "notification": "",
        "none": "",
        "dnd-notification": "",
        "dnd-none": "",
      },
      "return-type": "json",*/
      "exec": "~/.config/waybar/scripts/dunst.sh",
      "on-click": "dunstctl history-pop",
      "on-click-right": "dunstctl set-paused toggle",
      "restart-interval": 1,
      "escape": true,
    },
    "custom/gnma": {
      "format": " {} ",
      "interval": 5,
      "exec": "flatpak run com.chmouel.gnomeNextMeetingApplet dbus get_event",
      "exec-if": "pgrep -f gnome-next-meeting-applet",
      "max-length": 50,
      "min-length": 1,
      "on-click": "flatpak run org.gnome.Calendar",
    },

    "clock": {
      "format": "{:%a %Od %b %H:%M}",
      "format-alt": "{:%A, %B %d, %Y (%R)}  ",
      "tooltip-format": "\n<small><tt>{calendar}</tt></small>",
      "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "weeks-pos": "right",
        "on-scroll": 1,
        "on-click-right": "mode",
        "format": {
          "months": "<span color='#ffead3'><b>{}</b></span>",
          "days": "<span color='#ecc6d9'><b>{}</b></span>",
          "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
          "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
          "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
        },
      },
    },
    "keyboard-state": {
      "numlock": true,
      "capslock": true,
      "format": "{name} {icon}",
      "format-icons": {
        "locked": "",
        "unlocked": "",
      },
    },

    "pulseaudio": {
      "format": "<span font='Symbols Nerd Font' size='10500'>{icon}</span> {volume:2}%",
      "format-bluetooth": "{volume}%  {icon}",
      "format-muted": "<span font='Symbols Nerd Font' size='10500'>󰃙</span> {volume}%",
      "format-icons": {
        "headphones": "",
        "default": ["", ""],
      },
      "format-source": "",
      "format-source-muted": "",
      "scroll-step": 5,
      "on-click": "pamixer -t",
      "on-click-right": "pavucontrol",
    },
    "memory": {
      "interval": 5,
      "format": "<span font='Symbols Nerd Font' size='10500'></span> {}%",
    },
    "cpu": {
      "interval": 5,
      "format": "<span font='Symbols Nerd Font' size='10500'></span> {usage:2}%",
    },
    "battery": {
      // replaced by custom/battery (battery-profile.sh) — def kept inert
      "interval": 5,
      "states": {
        "good": 95,
        "warning": 30,
        "critical": 15,
      },
      "format": "{icon} {capacity}%",
      "format-charging": "  {capacity}%",
      "format-plugged": "  {capacity}%",
      "tooltip-format": "{timeTo} ({power}W)",
    },
    "custom/battery": {
      "interval": 5,
      "return-type": "json",
      "exec": "~/.config/waybar/scripts/battery-profile.sh",
      // cycle: performance -> balanced -> power-saver -> performance
      "on-click": "cur=$(busctl get-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile 2>/dev/null | sed -E 's/s \"?([a-z-]+)\"?$/\\1/'); case $cur in performance) next=balanced;; balanced) next=power-saver;; *) next=performance;; esac; busctl set-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile s \"$next\" && notify-send 'Power profile' \"$cur \u2192 $next\"",
      "on-click-right": "busctl get-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile | sed -E 's/s \"?(.*)\"?/profile: \\1/' | notify-send 'Power profile'",
    },
    "power-profiles-daemon": {
      "format": "<span font='Symbols Nerd Font' size='10500'>{icon}</span>",
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": "",
      },
    },
    "backlight": {
      "format-icons": ["󰃞", "󰃟", "󰃠"],
      "format": "<span font='Symbols Nerd Font' size='10500'>{icon}</span> {percent}%",
      "on-scroll-up": "brightnessctl set 5%+",
      "on-scroll-down": "brightnessctl set 5%-",
    },
    "bluetooth": {
      "format": "  {status}",
      "format-connected": "{device_alias}",
      "format-disabled": "",
      "format-off": "",
      "tooltip-format": "{controller_alias}\n{num_connections} connected",
      "on-click": "blueman-manager",
    },
    "mpris": {
      "format": "  {dynamic}",
      "format-paused": "  {dynamic}",
      "dynamic-len": 40,
      "on-click": "playerctl play-pause",
      "on-click-right": "playerctl next",
    },
    "disk": {
      "interval": 5,
      "format": "{free} ",
      "path": "/",
      "states": {
        "critical": 90,
      },
    },
    "tray": {
      "icon-size": 24,
    },
    "network": {
      "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
      "format-wifi": "<span font='Symbols Nerd Font' size='10500'>{icon}</span> {essid}",
      "max-length": 14,
      "format-ethernet": "󰈀  {ifname}",
      "format-linked": "󰈀  {ifname} (no IP)",
      "format-disconnected": "󰤭  offline",
      "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
      "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}\n{frequency} MHz",
      "on-click": "~/.config/sway/scripts/rofi-wifi-menu.sh",
      "on-click-right": "nm-connection-editor",
    },
    "privacy": {
      "icon-spacing": 4,
      "icon-size": 18,
      "transition-duration": 250,
      "modules": [
        {
          "type": "screenshare",
          "tooltip": true,
          "tooltip-icon-size": 24,
        },
        {
          "type": "audio-out",
          "tooltip": true,
          "tooltip-icon-size": 24,
        },
        {
          "type": "audio-in",
          "tooltip": true,
          "tooltip-icon-size": 24,
        },
      ],
    },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
    // "custom/logout": {
    //   "format": " ",
    //   "tooltip": false,
    //   "on-click": "wlogout",
    // },
    //symbols are not finished yet
  }
]
