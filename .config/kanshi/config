# Profiles activate automatically when their exact set of outputs is connected.
# Get names and description strings with: swaymsg -t get_outputs
#
# Match by description rather than by name (DP-1, HDMI-A-1) wherever a monitor
# can move between ports or docks, since the port name changes but the
# description does not.

profile laptop {
	output eDP-1 enable scale 1
}

